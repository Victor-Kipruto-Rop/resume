# Copy this file to .env and fill in real values. Never commit your real .env file.

PORT=4000

# A long, random secret only you know — required in the x-admin-token header
# to call /api/subscribers and /api/notify-new-post.
ADMIN_TOKEN=test123

# Restrict CORS to your live site once deployed (e.g. https://victor-kipruto-rop.github.io)
ALLOWED_ORIGIN=*

# SMTP settings used to send "new blog post" notification emails.
# Example using Gmail: create an App Password (not your normal password) at
# https://myaccount.google.com/apppasswords, then use:
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_SECURE=false
#   SMTP_USER=youraddress@gmail.com
#   SMTP_PASS=your-16-character-app-password
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
